# Postgres connection string.
#
# Neon (what Vercel provisions): the app uses Neon's HTTP driver automatically
# when the host looks like Neon, which is the right thing on serverless.
# Anything else falls back to node-postgres, so a local Docker Postgres works:
#
#   PGPW=$(openssl rand -hex 16)
#   docker run -d --name kabootar-db \
#     -e POSTGRES_PASSWORD="$PGPW" -e POSTGRES_DB=kabootar \
#     -p 5432:5432 postgres:17
#
# Substitute the placeholder below with that password. There is no real
# credential in this file, and there should never be one — the live value
# belongs in .env.local, which is gitignored.
#
DATABASE_URL="postgresql://postgres:<your-local-password>@localhost:5432/kabootar"
